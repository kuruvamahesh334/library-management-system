{
  "env": {
    "node":  true,
    "es2021": true,
    "jest":   true
  },
  "extends": "eslint:recommended",
  "parserOptions": { "ecmaVersion": 2021 },
  "rules": {
    "no-unused-vars":    ["warn", { "argsIgnorePattern": "^_" }],
    "no-console":        "warn",
    "no-undef":          "error",
    "prefer-const":      "warn",
    "no-var":            "error",
    "eqeqeq":            ["error", "always"],
    "no-duplicate-case": "error"
  }
}
